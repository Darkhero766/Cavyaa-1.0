modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "pkg-config", "qhull", "tcl", "tk"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Train CAVYAA"

[[workflows.workflow]]
name = "Train CAVYAA"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python train.py"

[workflows.workflow.metadata]
outputType = "console"
